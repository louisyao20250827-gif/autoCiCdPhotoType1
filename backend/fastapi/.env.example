# Copy to .env for local runs. Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key - server only>
CORS_ORIGINS=https://<react-project>.vercel.app,https://<webview-project>.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=^https://<your-prefix>-.*\.vercel\.app$
WRITE_RATE_LIMIT_PER_MINUTE=20
