# Copy to .env.local for local dev. In Vercel set these per project.
# Only PUBLIC values here — everything VITE_* ends up in the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
VITE_API_BASE_URL=https://chatlog-fastapi.onrender.com
# 1 = React web (Vercel project "web-react"), 2 = WebView build (Vercel project "web-webview")
VITE_APP_ID=1
